/* Spectrum Lyric Video Maker — dark modern theme */

* {
    color: #e6e8ee;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #0f1116;
}

QWidget#sidebar {
    background-color: #11131a;
    border-right: 1px solid #1c1f2a;
}

QPushButton {
    background-color: #1a1d27;
    color: #e6e8ee;
    border: 1px solid #262a37;
    border-radius: 8px;
    padding: 7px 14px;
}
QPushButton:hover {
    background-color: #232735;
    border-color: #3b4156;
}
QPushButton:pressed {
    background-color: #2c3142;
}
QPushButton:disabled {
    color: #6e7385;
    background-color: #161821;
    border-color: #1f2230;
}
QPushButton#primary {
    background-color: #7c5cff;
    border-color: #6e4ee8;
    color: #ffffff;
}
QPushButton#primary:hover {
    background-color: #8c70ff;
}
QPushButton#sidebarItem {
    text-align: left;
    border: none;
    border-radius: 0px;
    padding: 12px 18px;
    background-color: transparent;
    color: #c5c8d4;
}
QPushButton#sidebarItem:hover {
    background-color: #181b24;
    color: #ffffff;
}
QPushButton#sidebarItem:checked {
    background-color: #1a1d27;
    color: #ffffff;
    border-left: 3px solid #7c5cff;
}

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #161924;
    border: 1px solid #262a37;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #7c5cff;
    selection-color: #ffffff;
}
QPlainTextEdit, QTextEdit {
    padding: 8px;
}
QComboBox::drop-down {
    border: 0;
    width: 18px;
}
QComboBox QAbstractItemView {
    background-color: #161924;
    border: 1px solid #2a2f3e;
    selection-background-color: #2c3142;
}

QGroupBox {
    border: 1px solid #1f2230;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #9aa0b3;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #1f2230;
    border-radius: 6px;
}
QTabBar::tab {
    background-color: transparent;
    color: #c5c8d4;
    padding: 8px 14px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    background-color: #1a1d27;
    color: #ffffff;
}

QListView, QTableView {
    background-color: #11131a;
    border: 1px solid #1f2230;
    border-radius: 6px;
    gridline-color: #1c1f2a;
    selection-background-color: #2c3142;
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: #161924;
    color: #9aa0b3;
    border: none;
    padding: 6px 10px;
    font-weight: 600;
}

QProgressBar {
    background-color: #11131a;
    border: 1px solid #1f2230;
    border-radius: 8px;
    text-align: center;
    color: #c5c8d4;
    height: 16px;
}
QProgressBar::chunk {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7c5cff, stop:1 #21d4fd
    );
    border-radius: 8px;
}

QStatusBar {
    background-color: #11131a;
    color: #9aa0b3;
    border-top: 1px solid #1c1f2a;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #1f2230;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #7c5cff;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2a2f3e;
    min-height: 24px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #3b4156;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
